<idea-plugin>
    <id>com.github.gappylul.genitfx</id>
    <name>genit-fx</name>
    <vendor>gappylul</vendor>
    <description>Generates JavaFX @FXML fields and methods from FXML files.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.xml</depends>

    <actions>
        <action id="com.github.gappylul.genitfx.GenerateFxmlMembersAction"
                class="com.github.gappylul.genitfx.GenerateFxmlMembersAction"
                text="FXML Components and Methods"
                description="Generates @FXML fields from the associated FXML file">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>